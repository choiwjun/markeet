# ===========================================
# Markeet (마케트) 환경 변수 템플릿
# ===========================================
# 이 파일을 복사하여 .env.local 파일을 생성하세요
# cp .env.example .env.local
# ===========================================

# -------------------------------------------
# Supabase 설정
# -------------------------------------------
# Supabase 프로젝트 URL (클라이언트에서 사용)
NEXT_PUBLIC_SUPABASE_URL=https://naxwhjykeodawpjppzvy.supabase.co

# Supabase Anonymous Key (클라이언트에서 사용, 공개 가능)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5heHdoanlrZW9kYXdwanBwenZ5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjgzODI2MzgsImV4cCI6MjA4Mzk1ODYzOH0.JOQAMd7MCW4RP9QaNQUxCijkuCzu9yEYQDiraEbmjYs

# Supabase Service Role Key (서버 전용, 절대 공개 금지!)
# RLS를 우회할 수 있으므로 서버 사이드에서만 사용
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Project ID (타입 생성용)
# Supabase Dashboard URL에서 확인: https://app.supabase.com/project/<PROJECT_ID>
SUPABASE_PROJECT_ID=your-project-id

# -------------------------------------------
# OpenAI 설정 (자연어 질의 기능)
# -------------------------------------------
# OpenAI API Key (서버 전용)
OPENAI_API_KEY=sk-your-openai-api-key

# -------------------------------------------
# Upstash Redis 설정 (작업 큐 / 스케줄러)
# -------------------------------------------
# Upstash Redis REST URL
UPSTASH_REDIS_URL=https://your-redis-id.upstash.io

# Upstash Redis REST Token
UPSTASH_REDIS_TOKEN=your-upstash-token

# -------------------------------------------
# 애플리케이션 설정
# -------------------------------------------
# 애플리케이션 URL (배포 시 변경)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 환경 구분 (development | staging | production)
NODE_ENV=development
